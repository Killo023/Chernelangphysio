# =============================================================================
# Vercel: Project → Settings → Environment Variables → add each name/value.
# Redeploy after saving. Do not commit a real .env file with secrets.
# =============================================================================

# --- Contact form (required for sending) ---
# Pick ONE: Resend (below) OR SMTP (further down). Resend is recommended on Vercel.
RECIPIENT_EMAIL=cherne.langeveldt@gmail.com
# Use onboarding@resend.dev until your domain is verified in Resend (required for "from").
SENDER_EMAIL=onboarding@resend.dev
SERVICE_NAME=Cherné Langeveldt Physiotherapy

# --- Resend (recommended) ---
# Create key: https://resend.com/api-keys — paste the full key ONLY in Vercel, never in git.
RESEND_API_KEY=

# --- SMTP (only if you are NOT using Resend) ---
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- FAQ / AI chat (api/chat.js) ---
# Optional: https://aistudio.google.com/apikey — set only in Vercel, never commit.
GEMINI_API_KEY=
